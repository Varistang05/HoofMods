// icon and file info for HoofMods.exe
// want a diff icon? swap icon.ico (keep the name) and rebuild
#include <windows.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,1,0
PRODUCTVERSION 1,1,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "HoofMods: Mod Manager for Horses of Hoofprint Bay"
            VALUE "ProductName", "HoofMods"
            VALUE "FileVersion", "1.1.1"
            VALUE "ProductVersion", "1.1.1"
            VALUE "OriginalFilename", "HoofMods.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
